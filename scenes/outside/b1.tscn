[sub_resource type="Shader" id="Shader_8qqmj"]
code = "shader_type canvas_item;

uniform bool flash = false;

void fragment() {
	vec4 tex = texture(TEXTURE, UV);
	COLOR.rgb = ((vec3(1.0) - tex.rgb) * float(flash)) + (tex.rgb * float(!flash));
	COLOR.a = tex.a;
}
"

